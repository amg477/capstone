# Copy this to .streamlit/secrets.toml and update with your values
[data]
mode = "azure"  # Set to "local" if you want to use local files
AZURE_STORAGE_CONNECTION_STRING = "your_connection_string_here"
container = "capstone"
parquet_blob = "data/processed/processed_data.csv"
csv_blob = "data/processed/processed_data.csv"
attr_blob = "data/processed/processed_data.csv"
logo_blob = "data/penta_logo.png"
